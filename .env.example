# ===================================================
# MindFlow AI - Environment Configuration
# ===================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret for authenticating sessions (Generate a secure random string for production)
JWT_SECRET=mindflow_super_secret_jwt_key_replace_for_production_2026

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
# If omitted or left as default, MindFlow AI runs in high-fidelity simulated AI mode!
GEMINI_API_KEY=your_gemini_api_key_here

# Database Path (defaults to ./data/mindflow.db)
DATABASE_PATH=./data/mindflow.db
